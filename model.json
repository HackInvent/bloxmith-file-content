{
  "kind": "file_content",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "File Content",
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [],
    "outputs": [
      {
        "id": 1,
        "name": "contenu",
        "title": "Content",
        "emits": [
          "message/*",
          "text/plain",
          "application/json"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "path": "./input.txt",
    "create_if_missing": false,
    "encoding": "utf-8"
  },
  "runtime": {
    "initial_state": "ready",
    "active_worker": true,
    "generic_source": true,
    "file_source": true
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/inspector_panel.css"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/inspector_panel.css"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ]
  }
}
